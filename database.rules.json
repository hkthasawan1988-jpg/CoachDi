{
  "rules": {
    ".read": false,
    ".write": false,
    "appConfig": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && ((auth.uid === $uid && ((!data.exists() && newData.child('role').val() === 'athlete') || (data.exists() && newData.child('role').val() === data.child('role').val() && newData.child('subscription').val() === data.child('subscription').val()))) || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "coachProfiles": {
      ".read": "auth != null",
      "$coachId": {
        ".write": "auth != null && ((auth.uid === $coachId && root.child('users').child(auth.uid).child('role').val() === 'coach') || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "coachAvailability": {
      ".read": "auth != null",
      "$coachId": {
        ".write": "auth != null && ((auth.uid === $coachId && root.child('users').child(auth.uid).child('role').val() === 'coach') || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "coachLocations": {
      ".read": "auth != null",
      "$coachId": {
        ".write": "auth != null && ((auth.uid === $coachId && root.child('users').child(auth.uid).child('role').val() === 'coach') || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "coachVenues": {
      ".read": "auth != null",
      "$coachId": {
        ".write": "auth != null && ((auth.uid === $coachId && root.child('users').child(auth.uid).child('role').val() === 'coach') || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "coachPricing": {
      ".read": "auth != null",
      "$coachId": {
        ".write": "auth != null && ((auth.uid === $coachId && root.child('users').child(auth.uid).child('role').val() === 'coach') || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "coachTimeOff": {
      ".read": "auth != null",
      "$coachId": {
        ".write": "auth != null && ((auth.uid === $coachId && root.child('users').child(auth.uid).child('role').val() === 'coach') || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "coachPaymentAccounts": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$coachId": {
        ".read": "auth != null && (auth.uid === $coachId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && ((auth.uid === $coachId && root.child('users').child(auth.uid).child('role').val() === 'coach') || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "bookings": {
      ".read": "auth != null",
      "$bookingId": {
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'athlete' && ((!data.exists() && newData.child('athleteId').val() === auth.uid) || (data.exists() && data.child('athleteId').val() === auth.uid && newData.child('athleteId').val() === auth.uid && newData.child('coachId').val() === data.child('coachId').val()))) || (root.child('users').child(auth.uid).child('role').val() === 'coach' && (data.child('coachId').val() === auth.uid || newData.child('coachId').val() === auth.uid)) || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "auditLogs": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$id": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$id": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'coach' && newData.child('senderId').val() === auth.uid) || (root.child('users').child(auth.uid).child('role').val() === 'athlete' && newData.child('senderId').val() === auth.uid && newData.child('bookingId').isString() && root.child('bookings').child(newData.child('bookingId').val()).child('athleteId').val() === auth.uid && root.child('bookings').child(newData.child('bookingId').val()).child('coachId').val() === $uid))"
        }
      }
    },
    "paymentTransactions": {
      ".indexOn": [
        "coachId",
        "athleteId"
      ],
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'coach' && query.orderByChild === 'coachId' && query.equalTo === auth.uid) || (root.child('users').child(auth.uid).child('role').val() === 'athlete' && query.orderByChild === 'athleteId' && query.equalTo === auth.uid))",
      "$id": {
        ".read": "auth != null && (data.child('coachId').val() === auth.uid || data.child('athleteId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'coach' && newData.child('coachId').val() === auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "refunds": {
      ".indexOn": [
        "coachId",
        "athleteId"
      ],
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'coach' && query.orderByChild === 'coachId' && query.equalTo === auth.uid) || (root.child('users').child(auth.uid).child('role').val() === 'athlete' && query.orderByChild === 'athleteId' && query.equalTo === auth.uid))",
      "$id": {
        ".read": "auth != null && (data.child('coachId').val() === auth.uid || data.child('athleteId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('users').child(auth.uid).child('role').val() === 'coach' && newData.child('coachId').val() === auth.uid))"
      }
    },
    "subscriptionTransactions": {
      ".indexOn": [
        "coachId"
      ],
      "$id": {
        ".read": "auth != null && (data.child('coachId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "reviews": {
      "$id": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'athlete' && newData.child('athleteId').val() === auth.uid"
      }
    },
    "coachPaymentPublic": {
      ".read": "auth != null",
      "$coachId": {
        ".write": "auth != null && (auth.uid === $coachId || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "bookingChats": {
      "$bookingId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('bookings').child($bookingId).child('coachId').val() === auth.uid || root.child('bookings').child($bookingId).child('athleteId').val() === auth.uid)",
        "messages": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && (root.child('bookings').child($bookingId).child('coachId').val() === auth.uid || root.child('bookings').child($bookingId).child('athleteId').val() === auth.uid) && newData.child('senderId').val() === auth.uid"
          }
        }
      }
    },
    "subscriptionPaymentRequests": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$id": {
        ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'coach' && (!data.exists() && newData.child('coachId').val() === auth.uid)) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".read": "auth != null && (data.child('coachId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    }
  }
}